# =============================================================================
# DocuGardener Caddyfile — Production TLS Reverse Proxy
# =============================================================================
# Caddy automatically obtains and renews TLS certificates from Let's Encrypt.
# DOMAIN and LETSENCRYPT_EMAIL are injected from the production .env file.
#
# Routing:
#   grafana.{DOMAIN}  →  Grafana (grafana:3000)       — ops monitoring dashboard
#   /webhooks/*       →  FastAPI (docugardener:8000)  — GitHub webhook delivery (canonical)
#   /api/webhooks/*   →  FastAPI (docugardener:8000)  — /api prefix stripped before forward
#   /health           →  FastAPI (docugardener:8000)  — health probe
#   /diagnostics*     →  FastAPI (docugardener:8000)  — operator diagnostics
#   /auth/saml/*      →  FastAPI (docugardener:8000)  — SAML 2.0 SSO endpoints
#   /scim/v2*         →  FastAPI (docugardener:8000)  — SCIM 2.0 user provisioning (Okta)
#   /check*           →  FastAPI (docugardener:8000)  — VS Code extension drift check
#   /plugin-key*      →  FastAPI (docugardener:8000)  — VS Code extension API key management
#   /repos/*          →  FastAPI (docugardener:8000)  — repo contents + rules compiler endpoints
#   /billing/*        →  FastAPI (docugardener:8000)  — billing profile + quota endpoints
#   /inbox/*          →  FastAPI (docugardener:8000)  — analysis inbox (job triage) endpoints
#   /prompts/*        →  FastAPI (docugardener:8000)  — prompt config endpoints
#   *                 →  Next.js (web:3001)            — web app + its own /api/*
# =============================================================================

{
    email {$LETSENCRYPT_EMAIL}
}

# ── Grafana monitoring subdomain ─────────────────────────────────────────────
grafana.{$DOMAIN} {
    reverse_proxy grafana:3000
}

{$DOMAIN} {
    # ── Security headers ──────────────────────────────────────────────────────
    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "DENY"
        Referrer-Policy           "strict-origin-when-cross-origin"
        Permissions-Policy        "geolocation=(), microphone=(), camera=()"
        # Remove the Caddy version banner
        -Server
    }

    # ── Compression ───────────────────────────────────────────────────────────
    encode gzip

    # ── FastAPI: webhook endpoints (GitHub delivers here directly) ────────────
    # /webhooks/*     — canonical path used by FastAPI router
    # /api/webhooks/* — path baked into GitHub App manifest by onboarding flow
    handle /webhooks/* {
        reverse_proxy docugardener:8000
    }

    handle /api/webhooks/* {
        uri strip_prefix /api
        reverse_proxy docugardener:8000
    }

    # ── FastAPI: health probe + operator diagnostics ─────────────────────────
    handle /health {
        reverse_proxy docugardener:8000
    }

    handle /diagnostics* {
        reverse_proxy docugardener:8000
    }

    # ── FastAPI: SAML 2.0 SSO (SP-initiated login, ACS callback, metadata, logout) ─
    handle /auth/saml/* {
        reverse_proxy docugardener:8000
    }

    # ── FastAPI: SCIM 2.0 (Okta / IdP user provisioning) ─────────────────────
    handle /scim/v2* {
        reverse_proxy docugardener:8000
    }

    # ── FastAPI: VS Code extension endpoints (/check, /plugin-key) ───────────
    handle /check* {
        reverse_proxy docugardener:8000
    }

    handle /plugin-key* {
        reverse_proxy docugardener:8000
    }

    # ── FastAPI: repo contents + rules compiler (/repos/*) ───────────────────
    handle /repos/* {
        reverse_proxy docugardener:8000
    }

    # ── FastAPI: billing profile + quota (/billing/*) ────────────────────────
    handle /billing/* {
        reverse_proxy docugardener:8000
    }

    # ── FastAPI: analysis inbox (/inbox/*) ───────────────────────────────────
    handle /inbox/* {
        reverse_proxy docugardener:8000
    }

    # ── FastAPI: prompt config (/prompts/*) ──────────────────────────────────
    handle /prompts/* {
        reverse_proxy docugardener:8000
    }

    # ── FastAPI: feedback signal (/api/feedback — HMAC-verified, no session) ──
    # Must come before the Next.js catch-all so it isn't swallowed by Next.js.
    # FastAPI returns 200 on success and 4xx on tampered tokens; Next.js always
    # redirects (307) for both cases, breaking the test and real integrations.
    handle /api/feedback* {
        reverse_proxy docugardener:8000
    }

    # ── Next.js: everything else (web app + /api/* NextAuth routes) ───────────
    handle {
        reverse_proxy web:3001
    }
}
