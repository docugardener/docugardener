# =============================================================================
# DocuGardener Web Frontend — Environment Configuration
# =============================================================================
# Copy this file to web/.env and fill in the values.
# Do NOT commit .env to version control.
# =============================================================================

# Deployment mode — must match root .env
# "saas" = managed hosted | "air-gap" = fully offline self-hosted
DEPLOYMENT_MODE=saas
NEXT_PUBLIC_DEPLOYMENT_MODE=saas

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Must route through PgBouncer (port 5432 internal) — not directly to postgres.
DATABASE_URL="postgresql://postgres:changeme@localhost:5433/docugardener-web?schema=public"

# -----------------------------------------------------------------------------
# NextAuth.js
# -----------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="<generate: openssl rand -base64 32>"

# Public app URL — used in onboarding GitHub App manifest
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Webhook proxy for local dev — create a channel at https://smee.io/new
# For VPS/production: use your public domain (e.g. https://api.yourdomain.com)
NEXT_PUBLIC_WEBHOOK_URL="https://smee.io/YOUR_CHANNEL_ID"

# -----------------------------------------------------------------------------
# GitHub OAuth App (for user login — distinct from the GitHub App for webhooks)
# Create at: https://github.com/settings/developers → OAuth Apps
# Callback URL: http://localhost:3000/api/auth/callback/github
# -----------------------------------------------------------------------------
GITHUB_ID="<your-github-oauth-app-client-id>"
GITHUB_SECRET="<your-github-oauth-app-client-secret>"

# -----------------------------------------------------------------------------
# AI Provider — BYOK (Bring Your Own Key)
# Used as the default provider key in development.
# In production, tenants enter their own keys via the Settings UI.
# Supported providers: gemini, openai, anthropic
# -----------------------------------------------------------------------------
GEMINI_API_KEY=""
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""

# -----------------------------------------------------------------------------
# Zero-Config Bundled LLM Key
# -----------------------------------------------------------------------------
# When set, tenants without BYOK configured can use this operator-managed key.
# Must also be set in root .env (Python backend) — both files must stay in sync.
# In development: reuse your GEMINI_API_KEY value above.
BUNDLED_GEMINI_KEY=""
BUNDLED_GEMINI_MODEL="gemini-2.0-flash"

# -----------------------------------------------------------------------------
# Stripe Billing
# Sandbox keys: https://dashboard.stripe.com/test/apikeys
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_"
STRIPE_PRICE_PRO="price_"
STRIPE_PRICE_TEAM="price_"

# Set to "true" once Stripe is fully configured
NEXT_PUBLIC_BILLING_ENABLED=false

# -----------------------------------------------------------------------------
# Owner Operations Dashboard (optional — self-hosted: leave unset)
# The email of the operator who can access /admin/owner (returns 404 otherwise).
# -----------------------------------------------------------------------------
# OWNER_EMAIL=""
# Generate with: openssl rand -hex 32
# OWNER_ACCESS_TOKEN=""

# -----------------------------------------------------------------------------
# Analysis Feedback Signal
# Must match FEEDBACK_HMAC_SECRET in root .env. Leave empty to disable.
# Generate with: openssl rand -hex 32
# -----------------------------------------------------------------------------
FEEDBACK_HMAC_SECRET=""

# PostHog Analytics (optional — disabled if unset)
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
