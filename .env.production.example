# =============================================================================
# DocuGardener — PRODUCTION Environment
# =============================================================================
#
# SETUP STEPS:
#   1.  cp .env.production.example .env.production
#   2.  bash scripts/generate-secrets.sh >> .env.production
#   3.  Fill in every value marked  ← REQUIRED
#   4.  chmod 600 .env.production
#   5.  NEVER commit .env.production to version control
#
# ⚠️  Any variable left as its example value WILL break the deployment
#     or create a security vulnerability.
# =============================================================================

# -----------------------------------------------------------------------------
# Domain & TLS  (Caddy / Let's Encrypt)
# -----------------------------------------------------------------------------
# Your public domain — must have an A record pointing to this server's IP.
DOMAIN=docugardener.example.com                 # ← REQUIRED

# HYB-02: Deployment mode — controls billing, tenant resolution, and LLM constraints.
# saas (default)    : multi-tenant hosted, Stripe billing, cloud LLM.
# client-installed  : single-tenant, license-key billing, code never leaves customer network.
# air-gap           : single-tenant, offline signed license file, zero outbound connections.
DEPLOYMENT_MODE=saas

# HYB-04: Required when DEPLOYMENT_MODE != saas
# GITHUB_ORG=your-github-org        # ← REQUIRED for client-installed / air-gap
# ADMIN_EMAIL=admin@example.com     # ← REQUIRED for client-installed / air-gap

# HYB-06: License portal URL (client-installed only)
# LICENSE_PORTAL_URL=https://portal.docugardener.dev

# SEC-11: CORS origins allowed to call the FastAPI backend.
# Must be set explicitly in production — startup will refuse to boot if empty.
# Space-separated or JSON list format accepted by pydantic-settings.
ALLOWED_ORIGINS=["https://app.docugardener.dev"]  # ← REQUIRED  replace with your domain

# Email used for Let's Encrypt expiry notifications (not published).
LETSENCRYPT_EMAIL=ops@example.com               # ← REQUIRED

# -----------------------------------------------------------------------------
# Secrets  (generate with: bash scripts/generate-secrets.sh >> .env.production)
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET=                                # ← REQUIRED  openssl rand -base64 32
POSTGRES_PASSWORD=                              # ← REQUIRED  openssl rand -base64 24
REDIS_PASSWORD=                                 # ← REQUIRED  openssl rand -base64 24
ENCRYPTION_KEY=                                 # ← REQUIRED  openssl rand -base64 32

# -----------------------------------------------------------------------------
# GitHub App  (webhook engine)
# Create at: https://github.com/settings/apps
# -----------------------------------------------------------------------------
GITHUB_APP_ID=                                  # ← REQUIRED
GITHUB_WEBHOOK_SECRET=                          # ← REQUIRED  set in GitHub App settings
GITHUB_PRIVATE_KEY_PATH=/app/secrets/github-app.pem

# -----------------------------------------------------------------------------
# GitHub OAuth App  (user login via NextAuth)
# Create at: https://github.com/settings/developers → OAuth Apps
# Callback URL must be: https://<DOMAIN>/api/auth/callback/github
# -----------------------------------------------------------------------------
GITHUB_ID=                                      # ← REQUIRED
GITHUB_SECRET=                                  # ← REQUIRED

# -----------------------------------------------------------------------------
# Magic Link Email  (AUTH-01 — optional but strongly recommended)
# Without this, magic links are printed to the Next.js server log only.
# Get a free API key at https://resend.com (3,000 emails/month free).
# For custom SMTP instead, see docs/AUTH.md.
# -----------------------------------------------------------------------------
RESEND_API_KEY=                                 # ← RECOMMENDED
EMAIL_FROM=DocuGardener <noreply@yourdomain.com> # ← set to a verified Resend sender

# -----------------------------------------------------------------------------
# LLM — default provider
# -----------------------------------------------------------------------------
GEMINI_API_KEY=                                 # ← REQUIRED (or configure BYOK per-tenant)
GEMINI_MODEL=gemini-2.0-flash

# Zero-config bundled key shown as "Platform Default" in the Settings UI.
# Use a separate rate-limited key to protect your quota.
# Leave empty to require tenants to configure their own key.
BUNDLED_GEMINI_KEY=
BUNDLED_GEMINI_MODEL=gemini-2.0-flash

# -----------------------------------------------------------------------------
# Deployment Mode  (MODE-01 / SEC-10)
# -----------------------------------------------------------------------------
# Set to "sovereign" for fully self-hosted/on-prem deployments.
# When set, the Execution Mode card and governance export reflect "Sovereign"
# mode, and noDataEgressGuarantee is set to true in all exported profiles.
# Leave unset for SaaS / BYOK Cloud / BYOK Local deployments.
DEPLOYMENT_MODE=sovereign                        # ← set for on-prem deployments only

# -----------------------------------------------------------------------------
# Vector DB
# -----------------------------------------------------------------------------
# "weaviate" uses the bundled container — recommended for self-hosted.
# "pinecone" requires PINECONE_API_KEY and PINECONE_INDEX_NAME.
VECTOR_DB_PROVIDER=weaviate

# PINECONE_API_KEY=
# PINECONE_INDEX_NAME=docugardener
