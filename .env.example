# =============================================================================
# DocuGardener Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_NAME=DocuGardener
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Deployment mode: "saas" = standard self-hosted and managed hosted (default)
# "air-gap" = fully offline, no GitHub connectivity (enterprise only)
# client-installed mode is frozen — do not use
DEPLOYMENT_MODE=saas

# -----------------------------------------------------------------------------
# Server Settings
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
WORKERS=1

# -----------------------------------------------------------------------------
# GitHub App Configuration
# -----------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=./secrets/github-app.pem
GITHUB_WEBHOOK_SECRET=

# Development webhook proxy — create a free channel at https://smee.io/new
# then paste the URL here (e.g. https://smee.io/abc123xyz)
WEBHOOK_PROXY_URL=

# Comma-separated list of allowed CORS origins. Required in production.
# In dev, defaults to http://localhost:3000,3001,3003 when unset.
# Example: ALLOWED_ORIGINS=https://app.yourcompany.com,https://www.yourcompany.com
# ALLOWED_ORIGINS=

# Required for Automated App Onboarding (Manifest Flow)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WEBHOOK_URL=https://smee.io/YOUR_CHANNEL_ID

# Single-tenant mode — pin all backend writes to one tenant (self-hosted)
# SINGLE_TENANT_ID=

# Cross-repo drift detection (beta) — set to "true" to enable
CROSS_REPO_BETA=false

# -----------------------------------------------------------------------------
# Vector Database Configuration
# -----------------------------------------------------------------------------
# Provider: "weaviate" (recommended, included in Docker Compose) or "pinecone"
VECTOR_DB_PROVIDER=weaviate

# Pinecone settings
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=docugardener

# Weaviate settings (for self-hosted)
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=

# -----------------------------------------------------------------------------
# LLM Configuration
# -----------------------------------------------------------------------------
# Provider: "gemini" | "openai" | "anthropic" | "ollama"
LLM_PROVIDER=gemini

# Google Gemini settings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# OpenAI settings
# OPENAI_API_KEY=

# Anthropic settings
# ANTHROPIC_API_KEY=

# Ollama settings (local inference, zero data egress)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# -----------------------------------------------------------------------------
# Embeddings Configuration
# -----------------------------------------------------------------------------
# Model for local embeddings
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# -----------------------------------------------------------------------------
# Redis Configuration (for job queue)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Security Settings
# -----------------------------------------------------------------------------
# Ephemeral storage path (should be tmpfs mount)
TMPFS_PATH=/tmp/docugardener

# Maximum processing time per PR (seconds)
MAX_PROCESSING_TIME=120

# Drift score threshold (0-100, PRs above this are blocked)
DRIFT_SCORE_THRESHOLD=70

# -----------------------------------------------------------------------------
# Zero-Config Bundled LLM Key (UX-03)
# -----------------------------------------------------------------------------
# Rate-limited fallback Gemini key used when a tenant has no llmConfig set.
# Lets users see the product working on first PR without any configuration.
# Leave empty to require tenants to supply their own key.
BUNDLED_GEMINI_KEY=
BUNDLED_GEMINI_MODEL=gemini-2.5-flash-lite
# Platform LLM monthly cost ceiling across all tenants combined (EUR).
# Applies only when BUNDLED_GEMINI_KEY is set. Set to 0 to disable.
PLATFORM_LLM_MONTHLY_CAP_EUR=10.0

# -----------------------------------------------------------------------------
# Database (Python API)
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=changeme
SQL_DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@pgbouncer:5432/docugardener-web
ENCRYPTION_KEY=   # 32-byte hex: openssl rand -hex 32

# -----------------------------------------------------------------------------
# FEED-01: Analysis Feedback Signal
# -----------------------------------------------------------------------------
# URL of the FastAPI backend (used to build feedback links embedded in PR comments).
# In production this is the public-facing backend URL (e.g. https://api.docugardener.dev).
# In local dev it is typically http://localhost:8000.
APP_URL=http://localhost:8000
# HMAC signing secret for one-click feedback links. Must be set in production.
# Generate: openssl rand -hex 32
FEEDBACK_HMAC_SECRET=

# -----------------------------------------------------------------------------
# Stripe Billing (I-01)
# -----------------------------------------------------------------------------
# Sandbox keys: https://dashboard.stripe.com/test/apikeys
# Production keys: https://dashboard.stripe.com/apikeys
#
# Price IDs: Dashboard → Products → [Plan] → Pricing → copy "price_..." value
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_           # FastAPI /webhooks/stripe signing secret
STRIPE_WEBHOOK_SECRET_WEB=whsec_       # Next.js /api/stripe/webhooks signing secret
STRIPE_PRICE_PRO=price_
STRIPE_PRICE_TEAM=price_
# Set to true only when legal entity and Stripe are fully operational
BILLING_ENABLED=false

# Cron security — required in production; set to a random 32+ char string
CRON_SECRET=
# Dev only: set to "true" to skip CRON_SECRET check in non-prod deployments
ALLOW_UNAUTHENTICATED_CRON=
